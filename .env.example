# Copy this file to .env in the repository root before running the app.
# These defaults are for local development only.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB (started via Docker Compose or a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/sn58-validator-dashboard

# JWT — change this before any shared or production use
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=7d

# Client (Vite reads VITE_ prefixed variables)
VITE_API_URL=http://localhost:4000/api
